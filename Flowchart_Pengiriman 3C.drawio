  <diagram id="kinerja" name="6. Kinerja kurir">
    <mxGraphModel pageWidth="800" pageHeight="1117" grid="0" page="1" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell parent="1" vertex="1" style="strokeColor=#33444d;fontColor=#18272e;strokeWidth=1.3;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=20;text;strokeColor=none;fillColor=none;fontStyle=1;" id="title" value="6. Kinerja kurir">
          <mxGeometry as="geometry" x="20" y="16" width="760" height="40" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="strokeColor=#33444d;fontColor=#18272e;strokeWidth=1.3;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;rounded=1;arcSize=55;fillColor=#edf2f4;" id="s" value="Menu 3">
          <mxGeometry as="geometry" x="152.5" y="70" width="225" height="42" />
        </mxCell>
        <UserObject id="input" label="Pilih nama kurir dengan pilih()" link="data:page/id,pilih">
          <mxCell parent="1" vertex="1" style="strokeColor=#33444d;fontColor=#18272e;strokeWidth=1.3;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;shape=process;size=0.035;fillColor=#f3f6f7;">
            <mxGeometry as="geometry" x="45.0" y="146" width="440" height="48" />
          </mxCell>
        </UserObject>
        <mxCell parent="1" vertex="1" style="strokeColor=#33444d;fontColor=#18272e;strokeWidth=1.3;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;rounded=0;fillColor=#ffffff;" id="each" value="Untuk setiap kurir, kumpulkan pesanan Delivered.&lt;br&gt;Lewati kurir tanpa pesanan terkirim.">
          <mxGeometry as="geometry" x="45.0" y="230" width="440" height="60" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="strokeColor=#33444d;fontColor=#18272e;strokeWidth=1.3;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;rounded=0;fillColor=#ffffff;" id="class" value="n = jumlah pesanan terkirim untuk kurir tersebut.&lt;br&gt;Tepat = jumlah pesanan dengan 0 hari telat.&lt;br&gt;Ringan = jumlah pesanan dengan 1–2 hari telat.&lt;br&gt;Sedang = sisanya (3 hari atau lebih).">
          <mxGeometry as="geometry" x="45.0" y="330" width="440" height="98" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="strokeColor=#33444d;fontColor=#18272e;strokeWidth=1.3;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;rounded=0;fillColor=#ffffff;" id="score" value="Simpan skor setiap kurir:&lt;br&gt;100 × [0,309 × tepat + 0,109 × (n − ringan)&lt;br&gt;+ 0,582 × (n − sedang)] / n">
          <mxGeometry as="geometry" x="45.0" y="470" width="440" height="83" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="strokeColor=#33444d;fontColor=#18272e;strokeWidth=1.3;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;shape=parallelogram;size=0.06;fillColor=#ffffff;" id="report" value="Saat memproses kurir pilihan, tampilkan n serta jumlah&lt;br&gt;dan persen tiap kategori (100 × jumlah kategori / n).">
          <mxGeometry as="geometry" x="45.0" y="595" width="440" height="63" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="strokeColor=#33444d;fontColor=#18272e;strokeWidth=1.3;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;rhombus;fillColor=#f5f7f8;" id="q" value="Kurir pilihan&lt;br&gt;punya skor?">
          <mxGeometry as="geometry" x="135.0" y="703" width="260" height="104" />
        </mxCell>
